# Public site URL (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://relatronica.com

# Google Search Console HTML tag verification (meta content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional analytics (leave empty to ship with zero trackers)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase — certificate registry (Academy certificates are issued and verified server-side)
NEXT_PUBLIC_SUPABASE_URL=
# Server-side only: never expose this key to the browser
SUPABASE_SERVICE_ROLE_KEY=
